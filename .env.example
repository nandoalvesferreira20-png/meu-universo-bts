# Nenhuma variavel e obrigatoria para o build ou para testar o portal sem o Mural.
# Copie para .env.local somente se precisar configurar recursos opcionais.
# Na Vercel, cadastre valores em Project Settings > Environment Variables.
# Nao coloque credenciais reais neste arquivo. Veja docs/vercel-deployment.md.

# PUBLICA e opcional: URL HTTPS do portal nos resultados compartilhados.
# Defina antes do build; alteracoes exigem novo deployment.
NEXT_PUBLIC_SITE_URL=

# PUBLICA: deixe vazia para manter a publicacao do Mural indisponivel.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# PRIVADAS DE SERVIDOR: preencher apenas ao ativar o Mural com as protecoes prontas.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
MURAL_RATE_LIMIT_SECRET=

# Origem HTTPS exata das mutacoes, sem caminho. Opcional quando
# NEXT_PUBLIC_SITE_URL ja contem a origem correta. Se nao usar, deixe comentada;
# uma string vazia nao aciona o fallback do codigo existente.
# MURAL_PUBLIC_ORIGIN=

# Para acesso direto pela Vercel, usar o cabecalho fornecido pela plataforma.
# O padrao do codigo e cf-connecting-ip; nao serve automaticamente para Vercel.
MURAL_CLIENT_IP_HEADER=x-forwarded-for

# Ajustes opcionais; estes sao os padroes atuais, nao requisitos para deploy.
# MURAL_PUBLISH_LIMIT=3
# MURAL_PUBLISH_WINDOW_SECONDS=600
# MURAL_REPORT_LIMIT=5
# MURAL_REPORT_WINDOW_SECONDS=86400
# MURAL_AUTO_HIDE_THRESHOLD=8
# MURAL_ADMIN_LOGIN_LIMIT=5
# MURAL_ADMIN_LOGIN_WINDOW_SECONDS=900
