# Dependencies and package-manager caches
/node_modules/
/.npm-cache/
/.pnpm-store/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Generated test output (keep source tests and fixtures versionable)
/coverage/
/playwright-report/
/test-results/
/test-artifacts/

# Next.js, builds and incremental caches
/.next/
/out/
/build/
/dist/
/.turbo/
/.cache/
*.tsbuildinfo
# Generated by next dev/build/typegen; required locally, not committed.
/next-env.d.ts

# Logs and local temporary directories
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
/tmp/
/temp/

# Environment files: keep real values local; examples must contain placeholders.
.env
.env.*
!.env.example
!.env.local.example

# Private keys and credential containers
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
/.aws/
/.ssh/

# Local deployment state
/.vercel/

# OS and editor-local files; shared VS Code JSON configuration stays versionable
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
/.idea/
/.vscode/*.local.json
